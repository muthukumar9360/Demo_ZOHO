# Server Configuration
PORT=5000

# MongoDB Atlas Connection URI
# Replace with your actual MongoDB Atlas connection string:
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/cloud_task_manager?retryWrites=true&w=majority
MONGODB_URI=PASTE_MY_MONGODB_ATLAS_CONNECTION_STRING_HERE

# Database Name (default: cloud_task_manager)
DB_NAME=cloud_task_manager

# Client URL (for CORS restriction if needed)
CLIENT_URL=http://localhost:5173
